# Supabase PostgreSQL connection string
# Find this in: Supabase Dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase direct connection (required by Prisma for migrations)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Server
PORT=3000
NODE_ENV=development

# JWT — required in production (the server refuses to start without it, or with
# this placeholder). Use 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="rema-dev-secret-change-in-production"

# Frontend origins allowed to call the API with cookies (comma-separated).
# Default: https://rema-system.vercel.app + http://localhost:5173
# CORS_ORIGINS="https://rema-system.vercel.app,http://localhost:5173"

# Reverse proxies in front of the API (Render = 1). Defaults to 1 in production,
# 0 otherwise. Needed for correct client IPs in login rate limiting.
# TRUST_PROXY=1

# ─── AI INTEGRATION (Chat 20) ─────────────────────────────────────────────────
# Get your key from: https://console.anthropic.com/
# Add the real value to Render environment variables — NEVER commit it here.
ANTHROPIC_API_KEY=sk-ant-your-key-here
