generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String                @id @default(cuid())
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  email             String                @unique
  passwordHash      String
  name              String
  role              Role
  active            Boolean               @default(true)
  mustChangePassword Boolean              @default(false)
  avatarBase64       String?
  districtId        String?
  deliveryRuns      DeliveryRun[]
  assessmentsFiled  HouseholdAssessment[]
  householdAssessed Household[]           @relation("AssessedBy")
  incidentsReported Incident[]            @relation("ReportedBy")
  incidentsResolved Incident[]            @relation("ResolvedBy")
  notifications     Notification[]
  refreshTokens     RefreshToken[]
  radioCheckins     RadioCheckin[]
  routeLogs         RouteLog[]
  stockMovements    StockMovement[]
  district          District?             @relation(fields: [districtId], references: [id])

  @@map("users")
}

model District {
  id            String         @id @default(cuid())
  name          String         @unique
  population    Int
  latitude      Float
  longitude     Float
  createdAt     DateTime       @default(now())
  households    Household[]
  incidents     Incident[]
  radioCheckins RadioCheckin[]
  routes        Route[]
  subWarehouse  SubWarehouse?
  users         User[]

  @@map("districts")
}

model CentralWarehouse {
  id            String   @id @default(cuid())
  updatedAt     DateTime @updatedAt
  emk1Total     Int      @default(0)
  emk1Remaining Int      @default(0)
  emk2Total     Int      @default(0)
  emk2Remaining Int      @default(0)
  emk3Total     Int      @default(0)
  emk3Remaining Int      @default(0)

  @@map("central_warehouse")
}

model SubWarehouse {
  id                   String                @id @default(cuid())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  districtId           String                @unique
  name                 String
  address              String
  latitude             Float
  longitude            Float
  status               SubWarehouseStatus    @default(INACTIVE)
  capacitySqm          Int
  isBackup             Boolean               @default(false)
  backupForId          String?
  deliveryRuns         DeliveryRun[]
  stock                Stock?
  stockMovements       StockMovement[]
  district             District              @relation(fields: [districtId], references: [id])
  volunteerAssignments VolunteerAssignment[]

  @@map("sub_warehouses")
}

model Stock {
  id             String       @id @default(cuid())
  updatedAt      DateTime     @updatedAt
  emk1Total      Int          @default(0)
  emk1Remaining  Int          @default(0)
  emk2Total      Int          @default(0)
  emk2Remaining  Int          @default(0)
  emk3Total      Int          @default(0)
  emk3Remaining  Int          @default(0)
  subWarehouseId String       @unique
  subWarehouse   SubWarehouse @relation(fields: [subWarehouseId], references: [id])

  @@map("stock")
}

model CentralStock {
  id            String   @id @default(cuid())
  updatedAt     DateTime @updatedAt
  emk1Total     Int      @default(0)
  emk1Remaining Int      @default(0)
  emk2Total     Int      @default(0)
  emk2Remaining Int      @default(0)
  emk3Total     Int      @default(0)
  emk3Remaining Int      @default(0)

  @@map("central_stock")
}

model StockMovement {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  subWarehouseId String
  emkType        EmkType
  movementType   MovementType
  quantity       Int
  reason         String?
  performedById  String
  performedBy    User         @relation(fields: [performedById], references: [id])
  subWarehouse   SubWarehouse @relation(fields: [subWarehouseId], references: [id])

  @@index([subWarehouseId, createdAt])
  @@map("stock_movements")
}

model FloodAlert {
  id                   String                @id @default(cuid())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  warningLevelTwo      Boolean               @default(false)
  rainfallExceeds100mm Boolean               @default(false)
  streetFloodingReport Boolean               @default(false)
  activated            Boolean               @default(false)
  activatedAt          DateTime?
  phase                Int                   @default(0)
  volunteerAssignments VolunteerAssignment[]

  @@map("flood_alerts")
}

model Household {
  id                   String                @id @default(cuid())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  address              String
  districtId           String
  medicalUrgencyScore  Int                   @default(0)
  vulnerabilityScore   Int                   @default(0)
  floodExposureScore   Int                   @default(0)
  selfSufficiencyScore Int                   @default(0)
  isolationScore       Int                   @default(0)
  totalScore           Int                   @default(0)
  delivered            Boolean               @default(false)
  deliveredAt          DateTime?
  assessedById         String?
  priorityBand         PriorityBand          @default(STANDARD)
  recommendedEmk       EmkType               @default(EMK1)
  deliveryReceipts     DeliveryReceipt[]
  assessments          HouseholdAssessment[]
  assessedBy           User?                 @relation("AssessedBy", fields: [assessedById], references: [id])
  district             District              @relation(fields: [districtId], references: [id])

  @@index([districtId, delivered, priorityBand])
  @@map("households")
}

model HouseholdAssessment {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  householdId   String
  submittedById String
  cat1Score     Int
  cat2Score     Int
  cat3Score     Int
  cat4Score     Int
  cat5Score     Int
  totalScore    Int
  notes         String?
  household     Household @relation(fields: [householdId], references: [id])
  submittedBy   User      @relation(fields: [submittedById], references: [id])

  @@map("household_assessments")
}

model Volunteer {
  id           String                @id @default(cuid())
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  districtId   String
  name         String
  phone        String
  role         VolunteerRole         @default(VOLUNTEER)
  status       VolunteerStatus       @default(AVAILABLE)
  deliveryRuns DeliveryRun[]
  assignments  VolunteerAssignment[]

  @@map("volunteers")
}

model VolunteerAssignment {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  volunteerId    String
  subWarehouseId String
  alertId        String
  zone           String
  teamNumber     Int
  alert          FloodAlert   @relation(fields: [alertId], references: [id])
  subWarehouse   SubWarehouse @relation(fields: [subWarehouseId], references: [id])
  volunteer      Volunteer    @relation(fields: [volunteerId], references: [id])

  @@map("volunteer_assignments")
}

model DeliveryRun {
  id              String            @id @default(cuid())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  subWarehouseId  String
  teamNumber      Int
  zone            String
  departedAt      DateTime
  returnedAt      DateTime?
  status          DeliveryRunStatus @default(IN_PROGRESS)
  leadVolunteerId String
  performedById   String
  receipts        DeliveryReceipt[]
  leadVolunteer   Volunteer         @relation(fields: [leadVolunteerId], references: [id])
  performedBy     User              @relation(fields: [performedById], references: [id])
  subWarehouse    SubWarehouse      @relation(fields: [subWarehouseId], references: [id])

  @@index([subWarehouseId, status])
  @@map("delivery_runs")
}

model DeliveryReceipt {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  deliveryRunId String
  householdId   String
  emkType       EmkType
  quantity      Int         @default(1)
  deliveredAt   DateTime
  notes         String?
  deliveryRun   DeliveryRun @relation(fields: [deliveryRunId], references: [id])
  household     Household   @relation(fields: [householdId], references: [id])

  @@map("delivery_receipts")
}

model Route {
  id           String       @id @default(cuid())
  updatedAt    DateTime     @updatedAt
  districtId   String
  waterDepthCm Int
  active       Boolean      @default(true)
  zone         String
  deliveryMode DeliveryMode
  logs         RouteLog[]
  district     District     @relation(fields: [districtId], references: [id])

  @@map("routes")
}

model RouteLog {
  id            String       @id @default(cuid())
  createdAt     DateTime     @default(now())
  routeId       String
  previousDepth Int
  newDepth      Int
  previousMode  DeliveryMode
  newMode       DeliveryMode
  reportedById  String
  reportedBy    User         @relation(fields: [reportedById], references: [id])
  route         Route        @relation(fields: [routeId], references: [id])

  @@map("route_logs")
}

model Incident {
  id           String         @id @default(cuid())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  districtId   String
  type         IncidentType
  description  String
  status       IncidentStatus @default(OPEN)
  reportedById String
  resolvedById String?
  resolvedAt   DateTime?
  district     District       @relation(fields: [districtId], references: [id])
  reportedBy   User           @relation("ReportedBy", fields: [reportedById], references: [id])
  resolvedBy   User?          @relation("ResolvedBy", fields: [resolvedById], references: [id])

  @@index([districtId, status])
  @@map("incidents")
}

model RadioCheckin {
  id            String         @id @default(cuid())
  createdAt     DateTime       @default(now())
  districtId    String
  submittedById String
  scheduledTime RadioCheckTime
  status        RadioStatus    @default(OK)
  notes         String?
  district      District       @relation(fields: [districtId], references: [id])
  submittedBy   User           @relation(fields: [submittedById], references: [id])

  @@index([districtId, createdAt])
  @@map("radio_checkins")
}

model Notification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@map("notifications")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

enum Role {
  SUPER_ADMIN
  EMERGENCY_COORDINATOR
  HUB_MANAGER
  VOLUNTEER
  VIEWER
}

enum SubWarehouseStatus {
  INACTIVE
  ACTIVE
  BACKUP_ACTIVATED
}

enum EmkType {
  EMK1
  EMK2
  EMK3
}

enum MovementType {
  DISPATCH
  DELIVERY
  REALLOCATION
  ADJUSTMENT
  MOH_TRANSFER
}

enum PriorityBand {
  CRITICAL
  HIGH
  MEDIUM
  STANDARD
}

enum DeliveryRunStatus {
  IN_PROGRESS
  COMPLETE
  ABORTED
}

enum VolunteerRole {
  TEAM_LEADER
  VOLUNTEER
}

enum VolunteerStatus {
  AVAILABLE
  DEPLOYED
  INACTIVE
}

enum IncidentType {
  ROUTE_BLOCKED
  VOLUNTEER_SAFETY
  STOCK_SCARCITY
  BUILDING_FLOODED
  OTHER
}

enum IncidentStatus {
  OPEN
  ESCALATED
  RESOLVED
}

enum RadioCheckTime {
  T0800
  T1200
  T1600
  T2000
}

enum RadioStatus {
  OK
  ISSUE_REPORTED
}

enum DeliveryMode {
  MOTORBIKE
  BICYCLE_OR_FOOT
  BOAT
  SUSPENDED
}